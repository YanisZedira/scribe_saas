# ─── Clés pour le banc de test (copie en .env et renseigne) ──────────────

# Mistral : Voxtral (transcription) ET LLM (analyse) — même clé.
# https://console.mistral.ai/api-keys
MISTRAL_API_KEY=

# Vexa : bot qui rejoint Teams/Meet/Zoom. https://vexa.ai/account
VEXA_API_KEY=
VEXA_API_URL=https://api.cloud.vexa.ai

# Modèles (laisser par défaut)
VOXTRAL_MODEL=voxtral-mini-latest
MISTRAL_MODEL=mistral-small-latest
