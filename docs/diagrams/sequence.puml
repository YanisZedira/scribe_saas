@startuml Scribe-Sequence
title Scribe — Traitement d'une réunion (visio vs dictaphone)

actor Utilisateur as U
participant "API FastAPI" as API
participant "AudioSource" as AS
queue "File de tâches" as Q
participant "Worker/Pipeline" as W
participant "API STT" as STT
participant "API LLM" as LLM
database "BDD" as DB

U -> API : POST /meetings (mode, consentement)
API -> DB : crée Meeting (created)

alt Mode DICTAPHONE
  U -> API : POST /{id}/dictaphone (audio)
  API -> API : vérifie consentement + taille
  API -> Q : enqueue(audio_path)
  Q -> W : job
  W -> AS : DictaphoneSource.acquire()
  AS --> W : AudioBundle (1 piste, per_speaker=false)
else Mode VISIO
  U -> API : POST /{id}/visio (url | room)
  API -> AS : BotSource.join() / LiveKit
  AS --> API : bot_id
  API -> Q : enqueue(bot_id)
  Q -> W : job (webhook recording.done)
  W -> AS : acquire()
  AS --> W : AudioBundle (multipiste, per_speaker=true)
end

note over W : Chaîne commune
W -> STT : transcribe(bundle)
STT --> W : segments
W -> W : diarize()
W -> LLM : classify() + summarize()
LLM --> W : ton, thèmes, CR, actions (JSON)
W -> DB : persiste tout + status=done
U -> API : GET /{id}
API --> U : CR + actions + transcription
@enduml
