@startuml Scribe-Container
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
title Scribe — Diagramme de conteneurs (C4 niveau 2)

Person(user, "Utilisateur", "Manager distanciel / chef de projet présentiel")

System_Boundary(scribe, "Scribe") {
  Container(spa, "Front-end SPA", "HTML/JS, Tailwind", "Tableau de bord, captation, CR")
  Container(api, "API", "FastAPI", "REST: auth, meetings, dashboard, consent, webhooks")
  Container(audiosrc, "Abstraction Source Audio", "Python (factory)", "DictaphoneSource / LiveKitSource / BotSource")
  Container(pipe, "Pipeline IA", "Python", "transcribe -> diarize -> classify -> summarize")
  Container(worker, "Worker", "RQ", "Traitement asynchrone")
  ContainerQueue(queue, "File de tâches", "Redis + RQ")
  ContainerDb(db, "Base de données", "Postgres / SQLite", "users, meetings, segments, actions...")
}

System_Ext(stt, "API STT", "OpenAI / AssemblyAI / Deepgram")
System_Ext(llm, "API LLM", "OpenAI / Anthropic / Gemini")
System_Ext(visio, "Visio + bot", "LiveKit / Recall.ai (Teams/Meet/Zoom)")

Rel(user, spa, "Utilise", "HTTPS")
Rel(spa, api, "Appelle", "JSON/HTTPS")
Rel(api, audiosrc, "Sélectionne la source")
Rel(api, queue, "Programme un job")
Rel(queue, worker, "Distribue")
Rel(worker, pipe, "Exécute")
Rel(audiosrc, pipe, "AudioBundle normalisé")
Rel(pipe, stt, "Transcrit", "REST")
Rel(pipe, llm, "Résume/classe", "REST")
Rel(audiosrc, visio, "Capte l'audio", "SDK/bot")
Rel(pipe, db, "Persiste")
Rel(api, db, "Lit/écrit")
@enduml
