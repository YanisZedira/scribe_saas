# ─── Scribe — configuration backend ──────────────────────────────────────
SECRET_KEY=change-moi
DATABASE_URL=sqlite:///./scribe.db
CORS_ORIGINS=http://localhost:5173

# ─── Vexa : bot qui REJOINT Teams (+ transcription incluse) ──────────────
# Clé gratuite : https://vexa.ai/account . Sans clé → mode démo (exemple).
VEXA_API_URL=https://api.cloud.vexa.ai
VEXA_API_KEY=

# ─── LLM : analyse (résumé, décisions). API compatible OpenAI ────────────
# Mistral (FR) : https://console.mistral.ai/api-keys . Sans clé → mode démo.
LLM_BASE_URL=https://api.mistral.ai/v1
LLM_API_KEY=
LLM_MODEL=mistral-small-latest
