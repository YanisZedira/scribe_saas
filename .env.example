# ─── Scribe — configuration ──────────────────────────────────────────────
# Tout est optionnel : sans clé, l'app tourne entièrement en mode mock (0 €).

ENVIRONMENT=dev
SECRET_KEY=change-me-in-production

# Base de données (SQLite par défaut ; Postgres en Docker)
# DATABASE_URL=sqlite:///./scribe.db

# ─── Fournisseurs (mock | …) ─────────────────────────────────────────────
STT_PROVIDER=mock          # mock | openai | assemblyai | deepgram
LLM_PROVIDER=mock          # mock | openai | anthropic | gemini
VISIO_PROVIDER=vexa        # mock | vexa | livekit | recall

# ─── Clés API (renseigner selon les providers choisis) ───────────────────
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# ASSEMBLYAI_API_KEY=
# DEEPGRAM_API_KEY=
# RECALL_API_KEY=
# LIVEKIT_URL=
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=

# Vexa — bot de réunion Meet / Teams / Zoom (https://vexa.ai/account)
# VEXA_API_KEY=
# VEXA_API_URL=https://api.cloud.vexa.ai   # ou http://localhost:8056 (self-host)

# ─── File de tâches (worker asynchrone) ──────────────────────────────────
# REDIS_URL=redis://localhost:6379/0

# ─── Garde-fous ──────────────────────────────────────────────────────────
MAX_MEETING_MINUTES=90
MAX_UPLOAD_MB=200
DEFAULT_RETENTION_DAYS=90
