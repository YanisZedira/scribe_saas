# ─── Scribe backend — variables d'environnement (modèle) ─────────────────
# Copier en `.env` et renseigner. Sans clé, l'app tourne en mode démo (0 €).

SECRET_KEY=change-me-in-production
DEFAULT_RETENTION_DAYS=90

# ─── Speech-to-Text (branche feature/speech-to-text) ─────────────────────
STT_PROVIDER=mock            # mock | openai | deepgram | assemblyai
# OPENAI_API_KEY=
# DEEPGRAM_API_KEY=
# ASSEMBLYAI_API_KEY=

# ─── LLM (résumé + agents IA) ────────────────────────────────────────────
LLM_PROVIDER=mock            # mock | openai | anthropic | gemini
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# ─── Visio Meet / Teams / Zoom (Vexa) ────────────────────────────────────
VISIO_PROVIDER=vexa          # mock | vexa | livekit | recall
# VEXA_API_KEY=
# VEXA_API_URL=https://api.cloud.vexa.ai    # ou http://localhost:8056 (self-host)

# ─── Base de données ─────────────────────────────────────────────────────
# DATABASE_URL=sqlite:///./scribe.db
