# Variables lues par docker-compose.yml (copie en .env à la racine de scribe-v2/)

# Secret partagé entre le backend/agent et le service de transcription GPU
STT_API_KEY=scribe-stt-secret

# Vexa (bot Teams/Meet/Zoom) — laisser vide = mode démo.
# Cloud : clé sur https://vexa.ai/account  (VEXA_API_URL par défaut = cloud)
# Self-host : déployer Vexa puis mettre VEXA_API_URL=http://<host>:8056
VEXA_API_KEY=
VEXA_API_URL=https://api.cloud.vexa.ai
